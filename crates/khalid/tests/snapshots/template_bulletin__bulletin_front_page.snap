<form class="subscribe" method="post" action="/blog/subscribe">
<p><label for="split-signup-email">Your email address</label>
<input id="split-signup-email" name="email" type="email" autocomplete="email" required></p>
<p class="form-trap" aria-hidden="true"><label for="split-signup-homepage">Leave this empty</label>
<input id="split-signup-homepage" name="homepage" type="text" tabindex="-1" autocomplete="off"></p>
<p><button type="submit">Subscribe</button></p>
</form>
</section>
</section>
